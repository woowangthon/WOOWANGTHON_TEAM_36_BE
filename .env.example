# backend 환경변수 (계획서 9.6). 이 파일을 .env로 복사해 값을 채웁니다. .env는 커밋하지 않습니다.
# 배포 환경의 비밀값은 Secret Manager에 두고 Cloud Run 환경변수로 연결합니다(9.5).

# DB (9.4): 앱은 pooled(호스트에 -pooler), 마이그레이션은 direct. 드라이버는 postgresql+psycopg://
# 로컬 docker compose에서는 compose가 postgres 컨테이너 주소로 덮어씁니다.
DATABASE_URL=postgresql+psycopg://scholarship:scholarship@localhost:5432/scholarship
DATABASE_URL_DIRECT=

# 인증·암호화
JWT_SECRET=
FIELD_ENCRYPTION_KEY=

# AI 추출: GEMINI_MODEL은 T08에서 확정(계획서 9.6)
GEMINI_API_KEY=
GEMINI_MODEL=
# 로컬 전용: 1이면 Gemini 대신 목 응답
AI_MOCK=1

# 정기 수집 (9.3): Cloud Scheduler가 X-Cron-Token 헤더로 보내는 값
CRON_TOKEN=

# Google 로그인 (7.3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# 쉼표로 구분
ADMIN_EMAILS=
